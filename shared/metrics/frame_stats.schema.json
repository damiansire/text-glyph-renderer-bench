{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "BenchmarkReport",
    "description": "Reporte AGREGADO que cada PoC escribe en results/<poc-id>_stats.json. Refleja lo que los PoCs realmente emiten: un objeto por corrida (no un registro por frame). Algunos PoCs (3a/3b) son microbenchmarks que a propósito NO reportan veredicto de frame-budget; por eso `benchmark` es opcional y se admiten bloques de microbench alternativos.",
    "type": "object",
    "required": [
        "poc_id"
    ],
    "properties": {
        "poc_id": {
            "type": "string",
            "description": "Identificador del PoC. Debe ser uno de los 8 stacks comparados.",
            "enum": [
                "1a-web-dom",
                "1b-canvas2d",
                "1c-webgpu-atlas",
                "1d-webgpu-msdf",
                "2a-textkit2",
                "2b-metal3-coretext",
                "3a-rust-wgpu",
                "3b-rust-vello"
            ]
        },
        "measures": {
            "type": "string",
            "description": "Qué mide la corrida cuando NO es un frame end-to-end (p.ej. 3a/3b microbench)."
        },
        "meta": {
            "type": "object",
            "description": "Metadatos de plataforma / nota libre.",
            "additionalProperties": true
        },
        "file": {
            "type": "object",
            "description": "Métricas de carga del corpus.",
            "properties": {
                "line_count": { "type": "integer", "minimum": 0 },
                "load_ms": { "type": "number", "minimum": 0 },
                "split_ms": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": true
        },
        "benchmark": {
            "type": "object",
            "description": "Resultado end-to-end contra el presupuesto de 8.33 ms (PoCs que sí renderizan un frame). Los percentiles son NÚMEROS en ms (no strings).",
            "properties": {
                "total_frames": { "type": "integer", "minimum": 0 },
                "dropped_frames": { "type": "integer", "minimum": 0 },
                "drop_rate_pct": { "type": "number", "minimum": 0, "maximum": 100 },
                "p50_ms": { "type": "number", "minimum": 0 },
                "p95_ms": { "type": "number", "minimum": 0 },
                "p99_ms": { "type": "number", "minimum": 0 },
                "budget_ms": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": true
        },
        "atlas": {
            "type": "object",
            "description": "Estadísticas opcionales del atlas de glifos.",
            "properties": {
                "hit_rate": { "type": "number", "minimum": 0, "maximum": 1 },
                "fill_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": true
        }
    },
    "additionalProperties": true
}
